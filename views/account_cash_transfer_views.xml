<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         SEQUENCE
    ==================================================================== -->
    <record id="seq_account_cash_transfer" model="ir.sequence">
        <field name="name">Cash Transfer Sequence</field>
        <field name="code">account.cash.transfer</field>
        <field name="prefix">CT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ===================================================================
         TREE / LIST VIEW
    ==================================================================== -->
    <record id="view_account_cash_transfer_list" model="ir.ui.view">
        <field name="name">account.cash.transfer.list</field>
        <field name="model">account.cash.transfer</field>
        <field name="arch" type="xml">
            <list string="Cash Transfers"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'confirmed'">
                <field name="name" string="Reference"/>
                <field name="date"/>
                <field name="from_journal_id"/>
                <field name="to_journal_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================
         FORM VIEW
    ==================================================================== -->
    <record id="view_account_cash_transfer_form" model="ir.ui.view">
        <field name="name">account.cash.transfer.form</field>
        <field name="model">account.cash.transfer</field>
        <field name="arch" type="xml">
            <form string="Cash Transfer">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Transfer Details">
                            <field name="from_journal_id"
                                   readonly="state == 'confirmed'"
                                   context="{'restrict_journal_access': True}"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="from_journal_balance"
                                   string="↳ Balance"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"
                                   invisible="not from_journal_id"
                                   class="text-muted small"/>
                            <field name="to_journal_id"
                                   readonly="state == 'confirmed'"
                                   context="{'restrict_journal_access': True}"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="to_journal_balance"
                                   string="↳ Balance"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"
                                   invisible="not to_journal_id"
                                   class="text-muted small"/>
                            <field name="amount"
                                   readonly="state == 'confirmed'"/>
                            <field name="currency_id"
                                   readonly="state == 'confirmed'"
                                   groups="base.group_multi_currency"/>
                        </group>
                        <group string="Other Information">
                            <field name="date"
                                   readonly="state == 'confirmed'"/>
                            <field name="user_id"
                                   widget="many2one_avatar_user"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state == 'confirmed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note"
                                   placeholder="Add any additional notes here..."
                                   readonly="state == 'confirmed'"/>
                        </page>
                        <page string="Journal Entries"
                              invisible="not move_ids">
                            <field name="move_ids">
                                <list string="Journal Entries" create="0" edit="0" delete="0">
                                    <field name="name" string="Entry"/>
                                    <field name="journal_id"/>
                                    <field name="date"/>
                                    <field name="amount_total_signed" string="Amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         SEARCH VIEW
    ==================================================================== -->
    <record id="view_account_cash_transfer_search" model="ir.ui.view">
        <field name="name">account.cash.transfer.search</field>
        <field name="model">account.cash.transfer</field>
        <field name="arch" type="xml">
            <search string="Cash Transfers">
                <field name="name"/>
                <field name="date"/>
                <field name="from_journal_id"/>
                <field name="to_journal_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_from_journal" string="From Journal"
                            context="{'group_by': 'from_journal_id'}"/>
                    <filter name="group_to_journal" string="To Journal"
                            context="{'group_by': 'to_journal_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         ACTION
    ==================================================================== -->
    <record id="action_account_cash_transfer" model="ir.actions.act_window">
        <field name="name">Cash Transfers</field>
        <field name="res_model">account.cash.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_cash_transfer_search"/>
        <field name="context">{'restrict_journal_access': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cash transfer
            </p>
            <p>
                Transfer funds between cash and bank journals with automatic
                journal entry generation.
            </p>
        </field>
    </record>

    <!-- ===================================================================
         CASH & BANK JOURNAL DASHBOARD KANBAN VIEW
    ==================================================================== -->
    <record id="view_account_journal_dashboard_kanban" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban</field>
        <field name="model">account.journal</field>
        <field name="arch" type="xml">
            <kanban create="false" class="o_kanban_dashboard o_account_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="currency_id"/>
                <field name="current_cash_balance"/>
                <field name="cash_transfer_count"/>
                <field name="is_pinned_for_user"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click p-3 shadow-sm rounded border mb-3 {{ record.is_pinned_for_user.raw_value ? 'border-warning bg-warning-subtle' : 'bg-white' }}">
                            <div class="o_kanban_card_header d-flex justify-content-between align-items-center mb-2">
                                <div class="o_kanban_card_header_title">
                                    <div class="fw-bold fs-5 text-primary">
                                        <field name="name"/>
                                        <span class="badge bg-secondary ms-2"><field name="code"/></span>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <span t-if="record.type.raw_value == 'cash'" class="badge bg-info text-dark">Cash</span>
                                        <span t-if="record.type.raw_value == 'bank'" class="badge bg-success">Bank</span>
                                    </div>
                                </div>
                                <!-- Pin Button -->
                                <button type="object"
                                        name="action_toggle_pin"
                                        class="btn btn-sm p-1 border-0 bg-transparent"
                                        title="Pin as primary journal"
                                        t-attf-style="font-size:1.3rem; color: {{ record.is_pinned_for_user.raw_value ? '#f59e0b' : '#adb5bd' }};">
                                    <i t-attf-class="fa {{ record.is_pinned_for_user.raw_value ? 'fa-star' : 'fa-star-o' }}"/>
                                </button>
                            </div>
                            <div class="o_kanban_card_content my-3 p-3 bg-light rounded text-center border">
                                <div class="text-muted small fw-semibold text-uppercase">Current Balance</div>
                                <div class="fs-2 fw-bolder text-dark my-1">
                                    <field name="current_cash_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>
                            <div class="o_kanban_card_manage_pane border-top pt-2 d-flex justify-content-between align-items-center">
                                <button type="object" name="action_view_transfers" class="btn btn-sm btn-outline-primary fw-semibold">
                                    <i class="fa fa-exchange me-1"/> View Transactions (<field name="cash_transfer_count"/>)
                                </button>
                                <button type="object" name="action_create_transfer" class="btn btn-sm btn-success text-white fw-semibold">
                                    <i class="fa fa-plus me-1"/> New Transfer
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================================================================
         DASHBOARD ACTION
    ==================================================================== -->
    <record id="action_cash_journal_dashboard" model="ir.actions.act_window">
        <field name="name">Cash &amp; Bank Dashboard</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', 'in', ['cash', 'bank'])]</field>
        <field name="context">{'restrict_journal_access': True}</field>
        <field name="view_id" ref="view_account_journal_dashboard_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Cash or Bank Journals found
            </p>
            <p>
                Configure Cash and Bank journals in Accounting.
            </p>
        </field>
    </record>

    <!-- ===================================================================
         STANDALONE MAIN APP MENU & SUB-MENUS
    ==================================================================== -->
    <!-- Standalone Main App Root Menu -->
    <menuitem id="menu_cash_transfer_app_root"
              name="Cash Management"
              web_icon="account,static/description/icon.png"
              sequence="20"/>

    <!-- Sub-menu 1: Dashboard -->
    <menuitem id="menu_cash_transfer_dashboard"
              name="Dashboard"
              parent="menu_cash_transfer_app_root"
              action="action_cash_journal_dashboard"
              sequence="10"/>

    <!-- Sub-menu 2: Cash Transfers -->
    <menuitem id="menu_cash_transfer_transfers"
              name="Transfers"
              parent="menu_cash_transfer_app_root"
              action="action_account_cash_transfer"
              sequence="20"/>

    <!-- Sub-menu 3: Configuration (Manager only) -->
    <menuitem id="menu_cash_transfer_config"
              name="Configuration"
              parent="menu_cash_transfer_app_root"
              groups="group_cash_transfer_manager"
              sequence="30"/>

    <menuitem id="menu_cash_transfer_journals_config"
              name="Cash Journals"
              parent="menu_cash_transfer_config"
              action="action_cash_journal_config"
              sequence="10"/>

    <menuitem id="menu_cash_transfer_users_config"
              name="User Access Rights"
              parent="menu_cash_transfer_config"
              action="action_cash_transfer_user_rights"
              sequence="20"/>

</odoo>
