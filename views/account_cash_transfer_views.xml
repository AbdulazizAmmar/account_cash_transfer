<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         SEQUENCE
    ==================================================================== -->
    <record id="seq_account_cash_transfer" model="ir.sequence">
        <field name="name">Cash Transfer Sequence</field>
        <field name="code">account.cash.transfer</field>
        <field name="prefix">CT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ===================================================================
         TREE / LIST VIEW
    ==================================================================== -->
    <record id="view_account_cash_transfer_list" model="ir.ui.view">
        <field name="name">account.cash.transfer.list</field>
        <field name="model">account.cash.transfer</field>
        <field name="arch" type="xml">
            <list string="Cash Transfers"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'confirmed'">
                <field name="name" string="Reference"/>
                <field name="date"/>
                <field name="from_journal_id"/>
                <field name="to_journal_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================
         FORM VIEW
    ==================================================================== -->
    <record id="view_account_cash_transfer_form" model="ir.ui.view">
        <field name="name">account.cash.transfer.form</field>
        <field name="model">account.cash.transfer</field>
        <field name="arch" type="xml">
            <form string="Cash Transfer">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Transfer Details">
                            <field name="from_journal_id"
                                   readonly="state == 'confirmed'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="to_journal_id"
                                   readonly="state == 'confirmed'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="amount"
                                   readonly="state == 'confirmed'"/>
                            <field name="currency_id"
                                   readonly="state == 'confirmed'"
                                   groups="base.group_multi_currency"/>
                        </group>
                        <group string="Other Information">
                            <field name="date"
                                   readonly="state == 'confirmed'"/>
                            <field name="user_id"
                                   widget="many2one_avatar_user"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state == 'confirmed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note"
                                   placeholder="Add any additional notes here..."
                                   readonly="state == 'confirmed'"/>
                        </page>
                        <page string="Journal Entries"
                              invisible="not move_ids">
                            <field name="move_ids">
                                <list string="Journal Entries" create="0" edit="0" delete="0">
                                    <field name="name" string="Entry"/>
                                    <field name="journal_id"/>
                                    <field name="date"/>
                                    <field name="amount_total_signed" string="Amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         SEARCH VIEW
    ==================================================================== -->
    <record id="view_account_cash_transfer_search" model="ir.ui.view">
        <field name="name">account.cash.transfer.search</field>
        <field name="model">account.cash.transfer</field>
        <field name="arch" type="xml">
            <search string="Cash Transfers">
                <field name="name"/>
                <field name="from_journal_id"/>
                <field name="to_journal_id"/>
                <field name="user_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_from_journal" string="From Journal"
                            context="{'group_by': 'from_journal_id'}"/>
                    <filter name="group_to_journal" string="To Journal"
                            context="{'group_by': 'to_journal_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         ACTION
    ==================================================================== -->
    <record id="action_account_cash_transfer" model="ir.actions.act_window">
        <field name="name">Cash Transfers</field>
        <field name="res_model">account.cash.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_cash_transfer_search"/>
        <field name="context">{'default_date': context_today().strftime('%Y-%m-%d')}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cash transfer
            </p>
            <p>
                Transfer funds between cash and bank journals with automatic
                journal entry generation.
            </p>
        </field>
    </record>

    <!-- ===================================================================
         MENU ITEMS  –  under Accounting
    ==================================================================== -->
    <menuitem id="menu_account_cash_transfer_root"
              name="Cash Transfers"
              parent="account.menu_finance"
              action="action_account_cash_transfer"
              sequence="30"/>

</odoo>
