<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Account Journal Form View to add Cash Transfer Permissions -->
    <record id="view_account_journal_form_cash_transfer" model="ir.ui.view">
        <field name="name">account.journal.form.cash.transfer</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cash Transfer Access Control" invisible="type not in ['cash', 'bank']">
                    <group string="Allowed Users for Cash Transfers">
                        <field name="allowed_user_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Leave empty to allow all cash transfer users..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action for Cash & Bank Journal Configuration -->
    <record id="action_cash_journal_config" model="ir.actions.act_window">
        <field name="name">Cash &amp; Bank Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', 'in', ['cash', 'bank'])]</field>
        <field name="context">{'default_type': 'cash'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Cash and Bank Journals
            </p>
            <p>
                Assign user access rights to specific journals for cash transfers.
            </p>
        </field>
    </record>

</odoo>
