<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Res Users Form View to add Allowed Cash Journals -->
    <record id="view_users_form_cash_transfer" model="ir.ui.view">
        <field name="name">res.users.form.cash.transfer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cash Transfer Access" groups="account_cash_transfer.group_cash_transfer_manager">
                    <group string="Authorized Cash &amp; Bank Journals">
                        <field name="allowed_journal_ids" widget="many2many_tags"
                               domain="[('type', 'in', ['cash', 'bank'])]"
                               options="{'no_create': True}"
                               placeholder="Select allowed journals for this user..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action for User Rights configuration in Cash Management -->
    <record id="action_cash_transfer_user_rights" model="ir.actions.act_window">
        <field name="name">User Journal Rights</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="base.view_users_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage User Cash Journal Access
            </p>
            <p>
                Select users to assign allowed cash and bank journals.
            </p>
        </field>
    </record>

</odoo>
